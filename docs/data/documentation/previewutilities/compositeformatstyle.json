    {
      "content": [
        {
          "anchor": "overview",
          "level": 2,
          "text": "Overview",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "The ",
              "type": "text"
            },
            {
              "code": "CompositeFormatStyle",
              "type": "codeVoice"
            },
            {
              "text": " joins two format styles into a single one, routing the input data",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "first into the input format style, and then through the output format style.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "Use this format style through the ",
              "type": "text"
            },
            {
              "code": "FormatStyle",
              "type": "codeVoice"
            },
            {
              "text": " extension ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/Foundation/FormatStyle/composite(input:output:)",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ":",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "code": [
            "// Displays \"Quartz\"",
            "Text(\"black quartz\", format: .composite(input: .lastWord, output: .capitalize))"
          ],
          "syntax": "swift",
          "type": "codeListing"
        }
      ],
      "kind": "content"
    }
