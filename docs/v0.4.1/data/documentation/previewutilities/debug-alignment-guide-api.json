            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAlignmentGuideModifier",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " using ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(_:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "overlay a visualization of the alignment guides.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The modifier can be customized by passing ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAlignmentGuideModifier\/Trait",
              "isActive" : true,
              "overridingTitle" : "Trait",
              "overridingTitleInlineContent" : [
                {
                  "code" : "Trait",
                  "type" : "codeVoice"
                }
              ],
              "type" : "reference"
            },
            {
              "text" : "",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "instances:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "Text(\"A new age\\ndoes not begin all of a sudden\")",
            ".font(.title)",
            ".multilineTextAlignment(.trailing)",
            ".debugAlignmentGuide(.trailingFirstTextBaseline,",
            "    .lineWidth(8),",
            "    .fixedLength(vertical: 200),",
            "    .anchor(.trailing)",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
