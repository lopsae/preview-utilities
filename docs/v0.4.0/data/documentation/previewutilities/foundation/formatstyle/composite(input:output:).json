            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/CompositeFormatStyle",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " configured to join two format styles into a single one.",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "The input data is routed first into the input format style, and then through the output",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "format style.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
