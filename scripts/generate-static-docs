#!/bin/zsh

set -v

# Generate static documentation files from the package documentation catalog into a worktree.
# worktree folder. The static files are output to the `docs` folder in the worktree,

# The documentation worktree points to an independent repository tree that contains the generated
# documentation to deploy to GitHub pages.

# The static files are output into the `docs` folder in the worktree, which is the folder deployed
# to GitHub pages. This folder is served as `https://lopsae.github.io/preview-utilities/`.

# Uses --experimental-skip-synthesized-symbols as a workaround to the documentation of standard
# library protocols changing randomly on every rebuild.
# See https://github.com/lopsae/docc-extensions-issue

swift package \
    --allow-writing-to-directory "../preview-utilities-docs/docs" \
    generate-documentation \
    --target "PreviewUtilities" \
    --disable-indexing \
    --experimental-skip-synthesized-symbols \
    --transform-for-static-hosting \
    --hosting-base-path "/preview-utilities/v0.4.0" \
    --output-path "../preview-utilities-docs/docs/v0.4.0"


# Prettify jsons, to minimize changes upon rebuild.
find "../preview-utilities-docs/docs/v0.4.0" -name "*.json" -print0 | \
    xargs --null --max-args=1 --max-procs="$(sysctl -n hw.ncpu)" \
    sh -c 'jq --monochrome-output --indent 2 --sort-keys . "$1" > "$1.tmp" && mv "$1.tmp" "$1"' _

