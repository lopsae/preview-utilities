#!/bin/zsh

set -o errexit \
    -o nounset \
    -o pipefail

# Generate static documentation files from the package documentation catalog into a worktree folder.
# The worktree folder is expected to be `preview-utilities-docs`, at the same level as the
# repository folder.

# The documentation worktree points to an independent repository tree that contains the generated
# documentation to deploy to GitHub pages.

# The static files are output into the `docs` folder in the worktree, which is the folder deployed
# to GitHub pages.

# The `docs` folder is ultimately served as `https://lopsae.github.io/preview-utilities/`.

# Uses --experimental-skip-synthesized-symbols as a workaround to the documentation of standard
# library protocols changing randomly on every rebuild.
# See https://github.com/lopsae/docc-extensions-issue

echo "🤖 Generating Documentation"

export DOCC_JSON_PRETTYPRINT="YES"

version=$(<VERSION)
output_path="../preview-utilities-docs/docs/${version}"

swift package \
    --allow-writing-to-directory "../preview-utilities-docs/docs" \
    generate-documentation \
    --target "PreviewUtilities" \
    --disable-indexing \
    --experimental-skip-synthesized-symbols \
    --transform-for-static-hosting \
    --hosting-base-path "/preview-utilities/${version}" \
    --output-path "${output_path}"

./scripts/inject-version-badge "${output_path}" "${version}"

