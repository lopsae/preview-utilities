    {
      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Displays in an overlay a visual representation of a view’s alignment guide for a single axis,",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "either horizontal or vertical. The alignment marker added by this modifier is layered in an",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "overlay of the owner view, the original layout is never modified.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Apply this modifier using ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(horizontal:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " or",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(vertical:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "Text(\"Sphinx of Black Quartz\\nJudge my Vow\")",
            ".font(.title)",
            ".debugAlignmentGuide(horizontal: .trailing)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "debug-alignment-guide-default-single-axis",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Traits-and-Configuration",
          "level" : 3,
          "text" : "Traits and Configuration",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The overlay can be configured by passing ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAxisAlignmentGuideModifier\/Trait",
              "isActive" : true,
              "overridingTitle" : "Trait",
              "overridingTitleInlineContent" : [
                {
                  "code" : "Trait",
                  "type" : "codeVoice"
                }
              ],
              "type" : "reference"
            },
            {
              "text" : " instances to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(horizontal:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(vertical:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "Text(\"Lately I saw a house.\\nIt was burning.\")",
            ".font(.title)",
            ".multilineTextAlignment(.center)",
            ".debugAlignmentGuide(",
            "    horizontal: .leading,",
            "    .style(.mint.secondary), \/\/ Styles markers to mint.",
            "    .lineWidth(8),           \/\/ Sets the line width.",
            "    .scaledLength(2)         \/\/ Scales the marker to double the owner size.",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "debug-alignment-guide-explained-traits-single-axis",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Aliases-and-Protocols",
          "level" : 2,
          "text" : "Aliases and Protocols",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "This modifier is setup to receive as a generic the alignment to work with, either",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "code" : "HorizontalAlignment",
              "type" : "codeVoice"
            },
            {
              "text" : " or ",
              "type" : "text"
            },
            {
              "code" : "VerticalAlignment",
              "type" : "codeVoice"
            },
            {
              "text" : ". Convenience aliases for the typed modifiers are",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "available at ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugHorizontalAlignmentGuideModifier",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " and ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugVerticalAlignmentGuideModifier",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "The traits for this modifier are defined around a shared protocol ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAxisAlignmentGuideConfigurationProtocol",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "to share a single implementation for both vertical and horizontal alignment. The traits are",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "ultimately applied to the single implementation of this protocol: ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAxisAlignmentGuideConfiguration",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ".",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
      "kind" : "content"
    }
  ],
