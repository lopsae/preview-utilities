    {
      "content": [
        {
          "anchor": "overview",
          "level": 2,
          "text": "Overview",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "A ",
              "type": "text"
            },
            {
              "code": "TaskView",
              "type": "codeVoice"
            },
            {
              "text": " instance starts a task with the given operation as soon as it is displayed. While",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "the task is running, the ",
              "type": "text"
            },
            {
              "code": "pendingContent",
              "type": "codeVoice"
            },
            {
              "text": " is displayed. Once the task completes, the result",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "of the task is passed to ",
              "type": "text"
            },
            {
              "code": "completedContent",
              "type": "codeVoice"
            },
            {
              "text": " and the produced content is displayed.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "The task is scheduled using the ",
              "type": "text"
            },
            {
              "code": ".task",
              "type": "codeVoice"
            },
            {
              "text": " view modifier, if the view is removed while the task is",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "still executing, the task is cancelled.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        }
      ],
      "kind": "content"
    }
