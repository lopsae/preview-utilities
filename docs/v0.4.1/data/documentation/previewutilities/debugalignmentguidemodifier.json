      "content" : [
        {
          "anchor" : "overview",
          "level" : 2,
          "text" : "Overview",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "Displays in an overlay a visual representation of a view’s alignment guides. The alignment",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "markers added by this modifier are layered in an overlay of the owner view; the original layout",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "is never modified.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "inlineContent" : [
            {
              "text" : "Apply this modifier using ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(_:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "Text(\"Sphinx of Black Quartz\\nJudge my Vow\")",
            ".font(.title)",
            ".debugAlignmentGuide(.leadingLastTextBaseline)"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
          "inlineContent" : [
            {
              "identifier" : "debug-alignment-guide-default",
              "type" : "image"
            }
          ],
          "type" : "paragraph"
        },
        {
          "anchor" : "Traits-and-Configuration",
          "level" : 3,
          "text" : "Traits and Configuration",
          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The overlay can be configured by passing ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/DebugAlignmentGuideModifier\/Trait",
              "isActive" : true,
              "overridingTitle" : "Trait",
              "overridingTitleInlineContent" : [
                {
                  "code" : "Trait",
                  "type" : "codeVoice"
                }
              ],
              "type" : "reference"
            },
            {
              "text" : " instances to",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "identifier" : "doc:\/\/PreviewUtilities\/documentation\/PreviewUtilities\/SwiftUICore\/View\/debugAlignmentGuide(_:_:)",
              "isActive" : true,
              "type" : "reference"
            },
            {
              "text" : ":",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "code" : [
            "Text(\"Lately I saw a house.\\nIt was burning.\")",
            ".font(.title)",
            ".multilineTextAlignment(.center)",
            ".debugAlignmentGuide(.centerFirstTextBaseline,",
            "    .style(.mint.secondary),        \/\/ Styles both markers to mint.",
            "    .lineWidth(vertical: 8),        \/\/ Sets the vertical line width.",
            "    .extendedLength(horizontal: 40) \/\/ Extends the horizontal marker by 40.",
            ")"
          ],
          "syntax" : "swift",
          "type" : "codeListing"
        },
        {
