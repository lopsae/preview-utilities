          "type" : "heading"
        },
        {
          "inlineContent" : [
            {
              "text" : "The rotation transposes the control grid and rotates each control point’s position. Both the",
              "type" : "text"
            },
            {
              "text" : " ",
              "type" : "text"
            },
            {
              "text" : "color grid and each point coordinate are mapped clockwise:",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        },
        {
          "items" : [
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Color grid: Each cell ",
                      "type" : "text"
                    },
                    {
                      "code" : "(row, col)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " maps to ",
                      "type" : "text"
                    },
                    {
                      "code" : "(col, height - 1 - row)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            },
            {
              "content" : [
                {
                  "inlineContent" : [
                    {
                      "text" : "Coordinate: Each point ",
                      "type" : "text"
                    },
                    {
                      "code" : "(x, y)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : " maps to ",
                      "type" : "text"
                    },
                    {
                      "code" : "(1 - y, x)",
                      "type" : "codeVoice"
                    },
                    {
                      "text" : ".",
                      "type" : "text"
                    }
                  ],
                  "type" : "paragraph"
                }
              ]
            }
          ],
          "type" : "unorderedList"
        },
        {
          "inlineContent" : [
            {
              "text" : "Meshes not built from explicit points and colors are returned unchanged.",
              "type" : "text"
            }
          ],
          "type" : "paragraph"
        }
      ],
