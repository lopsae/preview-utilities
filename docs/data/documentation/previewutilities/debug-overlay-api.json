          "anchor": "overview",
          "level": 2,
          "text": "Overview",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "Apply the ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/DebugOverlayModifier",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " using ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/SwiftUICore/View/debugOverlay()",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " to overlay a",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "visualization of the boundaries, origin, and safe areas. The modifier can be configured",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "by passing ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/DebugOverlayModifier/Configuration/Trait",
              "isActive": true,
              "overridingTitle": "Trait",
              "overridingTitleInlineContent": [
                {
                  "code": "Trait",
                  "type": "codeVoice"
                }
              ],
              "type": "reference"
            },
            {
              "text": " instances:",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "identifier": "debug-overlay-components",
              "type": "image"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "The overlay can be configured by passing ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/DebugOverlayModifier/Configuration/Trait",
              "isActive": true,
              "overridingTitle": "Trait",
              "overridingTitleInlineContent": [
                {
                  "code": "Trait",
                  "type": "codeVoice"
                }
              ],
              "type": "reference"
            },
            {
              "text": "",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "instances to ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/SwiftUICore/View/debugOverlay(_:)",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ":",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "code": [
            "Rectangle()",
            ".fill(.yellow.gradient.secondary)",
            ".frame(width: 200, height: 80)",
            ".debugOverlay(",
            "    .size,                     // prints the size of the parent view",
            "    .bordersWidth(2),          // sets debug borders width to 2",
            "    .alignment(.innerTrailing) // aligns caption to trailing-center",
            ")"
          ],
          "syntax": "swift",
          "type": "codeListing"
        },
        {
