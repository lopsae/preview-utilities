    "title": "Floating Alignments"
  },
  "primaryContentSections": [
    {
      "content": [
        {
          "anchor": "overview",
          "level": 2,
          "text": "Overview",
          "type": "heading"
        },
        {
          "inlineContent": [
            {
              "text": "Floating content is content overlaid an owner view and aligned to an edge of its boundaries, either",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "inside or outside. Since the content is overlaid, the layout of the owner view is never modified,",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "hence the content ",
              "type": "text"
            },
            {
              "inlineContent": [
                {
                  "text": "floats",
                  "type": "text"
                }
              ],
              "type": "emphasis"
            },
            {
              "text": " over the owner view.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "identifier": "floating-alignment-alignment-examples",
              "metadata": {
                "abstract": [
                  {
                    "text": "Example floating alignments: ",
                    "type": "text"
                  },
                  {
                    "inlineContent": [
                      {
                        "text": "Outer Top Leading",
                        "type": "text"
                      }
                    ],
                    "type": "emphasis"
                  },
                  {
                    "text": " and ",
                    "type": "text"
                  },
                  {
                    "inlineContent": [
                      {
                        "text": "Inner Bottom Trailing",
                        "type": "text"
                      }
                    ],
                    "type": "emphasis"
                  },
                  {
                    "text": ".",
                    "type": "text"
                  }
                ]
              },
              "type": "image"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/FloatingAlignment",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " identifies the available alignment positions for floating content. Use it on",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "views that support floating content by building an instance, or using the available static",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "properties like ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/FloatingAlignment/outerTopLeading",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " or ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/FloatingAlignment/innerBottomTrailing",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": ".",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "See ",
              "type": "text"
            },
            {
              "identifier": "doc://PreviewUtilities/documentation/PreviewUtilities/FloatingAlignment",
              "isActive": true,
              "type": "reference"
            },
            {
              "text": " for the list of all convenience properties available.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "Inner alignments identify the inner positions along the owner view. These work as equivalent to the",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "SwiftUI alignments with the same names.",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "identifier": "floating-alignment-inner-alignments",
              "metadata": {
                "abstract": [
                  {
                    "text": "All inner alignments.",
                    "type": "text"
                  }
                ]
              },
              "type": "image"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "text": "Outer alignments identify the outer positions along the owner view’s boundaries, and are defined",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "through a major component (top, leading, bottom, and trailing) and a minor component (top, leading,",
              "type": "text"
            },
            {
              "text": " ",
              "type": "text"
            },
            {
              "text": "bottom, trailing, center, above, and under, depending on the major).",
              "type": "text"
            }
          ],
          "type": "paragraph"
        },
        {
          "inlineContent": [
            {
              "identifier": "floating-alignment-outer-alignments",
              "metadata": {
                "abstract": [
                  {
                    "text": "All outer alignments.",
                    "type": "text"
                  }
                ]
              },
              "type": "image"
            }
          ],
          "type": "paragraph"
        }
      ],
      "kind": "content"
    }
  ],
